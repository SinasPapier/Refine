# Kopiere diese Datei zu ".env" und trage deine Supabase-Werte ein.
# Beide Werte findest du in Supabase unter: Project Settings -> API
# Der Anon-Key darf öffentlich sein – die Daten sind durch Row Level Security geschützt.

VITE_SUPABASE_URL=https://dein-projekt.supabase.co
VITE_SUPABASE_ANON_KEY=dein-anon-key
